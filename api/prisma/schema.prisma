// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UnitItemStatus {
  available
  rented
  maintainance
}

enum TransactionPaymentMethod {
  pending_payment
  qris
  cash
}

enum OrderStatus {
  pending
  complete
  cancel
}

enum TransactionStatus {
  pending
  complete
  cancel
  expired
}

enum RentedUnitStatus {
  playing
  finished
  cancel
}

model UnitItem {
  id                   Int                     @id @default(autoincrement())
  title                String
  description          String                  @db.Text
  rent_price           Float
  status               UnitItemStatus        @default(available)
  created_at           DateTime                @default(now())
  updated_at           DateTime                @updatedAt
  
  rentedUnitOrder      RentedUnitOrder[]

  // Berikan nama asli tabel
  @@map("unit_item")
}

model FnBItem {
  id                  Int                    @id @default(autoincrement())
  title               String
  description         String                 @db.Text
  price               Float
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  fnbItemOrder FnBItemOrder[]

  @@map("fnb_item")
}

model Orders {
  id              Int           @id @default(autoincrement())
  order_no        String        @unique
  customer_name   String
  subtotal        Float
  total           Float
  status          OrderStatus @default(pending)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now())

  rentedUnitOrder RentedUnitOrder[]
  fnbItemOrder    FnBItemOrder[]
  transaction     Transaction[]

  @@map("orders")
}

model RentedUnitOrder {
  id             Int      @id @default(autoincrement())
  order_id       Int // relasi ke tabel transaksi `Transaction`
  unit_item_id   Int // relasi ke tabel unit_item `Unit_Item`
  play_time      Float
  sub_total      Float
  start_time     DateTime @default(now())
  end_time       DateTime
  status         RentedUnitStatus @default(playing)

  orders         Orders      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  unitItem       UnitItem   @relation(fields: [unit_item_id], references: [id], onDelete: Cascade)

  @@map("rented_unit_order")
}

model FnBItemOrder {
  id             Int   @id @default(autoincrement())
  order_id       Int // relasi ke tabel `Transaction`
  fnb_item_id    Int // relasi ke tabel `Fnb_Item`
  quantity       Int
  sub_total      Float

  orders Orders  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  fnbItem        FnBItem    @relation(fields: [fnb_item_id], references: [id], onDelete: Cascade)

  @@map("fnb_item_order")
}

model Transaction {
  id              Int                        @id @default(autoincrement())
  order_id        Int                        @unique
  transaction_no  String
  payment_method  TransactionPaymentMethod @default(pending_payment)
  amount          Float
  snap_url        String?
  snap_expiry     DateTime?
  status          TransactionStatus         @default(pending)
  created_at      DateTime                   @default(now())
  updated_at      DateTime                   @default(now())

  orders Orders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  
  @@map("order_transaction")
}

model User {
  id Int @id @default(autoincrement())
  full_name String
  email String
  username String
  password String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  refreshToken UserRefreshToken[]
  @@map("user")
}

model UserRefreshToken {
  id Int @id @default(autoincrement())
  user_id Int
  token String
  expires_at DateTime
  is_revoked Boolean
  user_agent String
  ip_address String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_refresh_token")

}